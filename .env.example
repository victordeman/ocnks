# postgresql:// connection string (Vercel Postgres or Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ogldb"
# generate with openssl rand -base64 32
AUTH_SECRET="your-32-byte-secret-here-change-in-production"
# http://localhost:3000 locally; production domain on Vercel
AUTH_URL="http://localhost:3000"
# e.g. "OCNKS Global <onboarding@resend.dev>"
EMAIL_FROM="OCNKS Global <onboarding@resend.dev>"
# transactional email (Resend)
RESEND_API_KEY="re_123456789"
# email that becomes the first ADMIN user on first deploy
ADMIN_BOOTSTRAP_EMAIL="admin@ocnksglobal.com"
# public company contact email
NEXT_PUBLIC_COMPANY_EMAIL=ocnksglobal@gmail.com
# public company contact phone number
NEXT_PUBLIC_COMPANY_PHONE=+2348108690772
