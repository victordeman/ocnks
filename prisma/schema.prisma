generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  phone          String?
  role           Role            @default(CLIENT)
  companyName    String?
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt @default(now())
  accounts       Account[]
  sessions       Session[]
  authenticators Authenticator[]
  rfqs           Rfq[]           @relation("ClientRfqs")
  assignedRfqs   Rfq[]           @relation("AssigneeRfqs")
  events         RfqEvent[]
  attachments    Attachment[]
  auditLogs      AuditLog[]
}

enum Role {
  CLIENT
  STAFF
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @id @default(cuid())
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
}

model ServiceLine {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  summary   String
  details   String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
  rfqs      Rfq[]
}

enum RfqStatus {
  RECEIVED
  UNDER_REVIEW
  QUOTED
  AWARDED
  DECLINED
  CLOSED
}

model Rfq {
  id            String       @id @default(cuid())
  publicId      String       @unique // human-readable OGL-YYYY-####, allocated in a transaction in a later phase
  status        RfqStatus    @default(RECEIVED)
  serviceLineId String
  serviceLine   ServiceLine  @relation(fields: [serviceLineId], references: [id])
  contactName   String
  companyName   String
  email         String
  phone         String
  location      String
  scope         String
  desiredStart  DateTime?
  clientUserId  String?
  clientUser    User?        @relation("ClientRfqs", fields: [clientUserId], references: [id])
  assigneeId    String?
  assignee      User?        @relation("AssigneeRfqs", fields: [assigneeId], references: [id])
  events        RfqEvent[]
  attachments   Attachment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

model RfqEvent {
  id          String   @id @default(cuid())
  rfqId       String
  rfq         Rfq      @relation(fields: [rfqId], references: [id])
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  type        String // e.g. SUBMITTED, STATUS_CHANGED, COMMENT
  message     String
  createdAt   DateTime @default(now())

  @@index([rfqId])
}

model Attachment {
  id           String   @id @default(cuid())
  rfqId        String
  rfq          Rfq      @relation(fields: [rfqId], references: [id])
  fileName     String
  contentType  String
  size         Int
  storageKey   String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([rfqId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entity      String
  entityId    String
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
}

model RfqCounter {
  year Int @id
  last Int
}
